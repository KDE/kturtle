msgstr "הפקודה %1 מקבלת מחרוזת בלבד כפרמטר."

#: interpreter/executer.cpp:452
#, kde-format
msgid "The %1 command only accepts strings as its parameters."
msgstr "הפקודה %1 מקבלת מחרוזות בלבד כפרמטרים."

#: interpreter/executer.cpp:457
#, kde-format
msgid "The %1 command only accepts a number as its parameter."
msgstr "הפקודה %1 מקבלת מספר בלבד כפרמטר."

#: interpreter/executer.cpp:459
#, kde-format
msgid "The %1 command only accepts numbers as its parameters."
msgstr "הפקודה %1 מקבלת מספרים בלבד כפרמטרים."

#: interpreter/executer.cpp:464
#, kde-format
msgid "The %1 command only accepts an answer as its parameter."
msgstr "הפקודה %1 מקבלת תשובה בלבד כפרמטר."

#: interpreter/executer.cpp:466
#, kde-format
msgid "The %1 command only accepts answers as its parameters."
msgstr "הפקודה %1 מקבלת תשובות בלבד כפרמטרים."

