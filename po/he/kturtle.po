#, kde-format
msgid "You tried to divide by zero"
msgstr "ניסית לחלק באפס"

#: interpreter/executer.cpp:948
#, kde-format
msgid "You tried to divide a non-number, '%1'"
msgstr "ניסית לחלק איבר שאינו מספר, ‚%1’"

#: interpreter/executer.cpp:950
#, kde-format
msgid "You tried to divide by a non-number, '%1'"
msgstr "ניסית לחלק באיבר שאינו מספר, ‚%1’"

#: interpreter/executer.cpp:957
#, kde-format
msgid "You need two numbers to raise a power"
msgstr "צריך שני מספרים כדי להעלות בחזקה"

#: interpreter/executer.cpp:968
#, kde-format
