#: interpreter/parser.cpp:113
#, kde-format
msgid "Did not expect '%1', instead expected a closing parenthesis, ')'"
msgstr ""
"לא אמור היה להיות כאן ‚%1’, אמור היה להיות פה החלק הסוגר של הסוגריים, ‚)’"

#: interpreter/parser.cpp:116
#, kde-format
msgid "Expected 'to' after 'for'"
msgstr "אמור להיות ‚עד’ אחרי ‚לכל’"

#: interpreter/parser.cpp:119
#, kde-format
msgid "Expected a name for a command after 'learn' command"
msgstr "אמור להיות שם לפקודה אחרי הפקודה ‚למידה’"

#: interpreter/parser.cpp:281
#, kde-format
msgid "You cannot put '%1' here."
msgstr "אי אפשר לשים כאן ‚%1’."

#: interpreter/parser.cpp:316
#, kde-format
msgid ""
"Text string was not properly closed, expected a double quote, ' \" ', to "
"close the string."
msgstr ""
"מחרוזת הטקסט לא נסגרה כראוי, אמורות היו להיות מירכאות כפולות, ‚ \" ’, כדי "
"לסגור את המחרוזת."

#: interpreter/parser.cpp:643
#, kde-format
msgid "'for' was called wrongly"
msgstr "הקריאה להתניית ‚עבור’ שגויה"

